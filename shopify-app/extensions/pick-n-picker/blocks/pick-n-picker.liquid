{% comment %}
  Pick-N picker app block. Merchants add this via the theme editor (app
  blocks are natively insertable without editing theme templates) and
  configure eligible products + pick count through the settings below —
  no code changes required.
{% endcomment %}

<div
  class="boxcraft-picker"
  data-boxcraft-picker
  data-pick-count="{{ block.settings.pick_count }}"
  data-guardrail-url="{{ block.settings.guardrail_worker_url }}"
>
  <h3 class="boxcraft-picker__title">{{ block.settings.title }}</h3>
  <p class="boxcraft-picker__counter" data-boxcraft-counter>
    0 / {{ block.settings.pick_count }} selected
  </p>

  <div class="boxcraft-picker__grid" data-boxcraft-grid>
    {% if block.settings.eligible_collection != blank %}
      {% for product in block.settings.eligible_collection.products %}
        {% for variant in product.variants %}
          <button
            type="button"
            class="boxcraft-picker__item"
            data-boxcraft-item
            data-variant-id="{{ variant.id }}"
            data-variant-price="{{ variant.price | divided_by: 100.0 }}"
            aria-pressed="false"
          >
            {%- assign item_image = variant.image | default: product.featured_image -%}
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 200 }}"
                alt="{{ variant.title }}"
                loading="lazy"
                width="100"
                height="100"
              >
            {% endif %}
            <span class="boxcraft-picker__item-title">
              {{ product.title }}{% if variant.title != "Default Title" %} — {{ variant.title }}{% endif %}
            </span>
            <span class="boxcraft-picker__item-price">{{ variant.price | money }}</span>
          </button>
        {% endfor %}
      {% endfor %}
    {% endif %}
  </div>

  <p class="boxcraft-picker__blocked-message" data-boxcraft-blocked hidden></p>

  <button type="button" class="boxcraft-picker__add-to-cart" data-boxcraft-add-to-cart disabled>
    Add Bundle to Cart
  </button>
</div>

<script type="module" src="{{ 'pick-n-picker.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Pick-N Picker",
  "target": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Block title", "default": "Build your box" },
    { "type": "collection", "id": "eligible_collection", "label": "Eligible products collection" },
    {
      "type": "range",
      "id": "pick_count",
      "label": "Number of items to pick",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "guardrail_worker_url",
      "label": "Guardrail Worker URL (leave blank to disable location checks)",
      "default": ""
    }
  ]
}
{% endschema %}
