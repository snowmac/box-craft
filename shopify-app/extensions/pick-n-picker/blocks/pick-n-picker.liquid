{% comment %}
  Pick-N picker app block. Merchants add this via the theme editor (app
  blocks are natively insertable without editing theme templates).

  T7: if a box matching the "Box handle" setting exists in the app's
  boxcraft.boxes metafield (written by the merchant admin — see
  workers/app-backend/src/boxes-metafield.ts), its title/collection/pick
  count/discount are used instead of the settings below, which stay as
  the fallback for stores that haven't set up a box yet.
{% endcomment %}

{% assign boxcraft_box = nil %}
{% assign boxcraft_boxes = app.metafields.boxcraft.boxes.value %}
{% if boxcraft_boxes %}
  {% for box in boxcraft_boxes %}
    {% if box.handle == block.settings.box_handle and box.active %}
      {% assign boxcraft_box = box %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if boxcraft_box %}
  {% assign picker_title = boxcraft_box.title %}
  {% assign picker_pick_count = boxcraft_box.pick_count %}
  {% assign picker_collection = collections[boxcraft_box.collection_handle] %}
{% else %}
  {% assign picker_title = block.settings.title %}
  {% assign picker_pick_count = block.settings.pick_count %}
  {% assign picker_collection = block.settings.eligible_collection %}
{% endif %}

{% assign boxcraft_discount_text = "" %}
{% if boxcraft_box.discount.type == "percent" %}
  {% assign boxcraft_discount_text = "Save " | append: boxcraft_box.discount.percent | append: "% on " | append: picker_pick_count %}
{% elsif boxcraft_box.discount.type == "tiered" %}
  {% assign boxcraft_top_tier = boxcraft_box.discount.tiers | last %}
  {% if boxcraft_top_tier %}
    {% assign boxcraft_discount_text = "Save up to " | append: boxcraft_top_tier.percent | append: "% on " | append: boxcraft_top_tier.min_items %}
  {% endif %}
{% endif %}

<link rel="stylesheet" href="{{ 'pick-n-picker.css' | asset_url }}">

<div
  class="boxcraft-picker"
  data-boxcraft-picker
  data-pick-count="{{ picker_pick_count }}"
  data-guardrail-url="{{ block.settings.guardrail_worker_url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-box="{{ block.settings.box_handle }}"
>
  <h3 class="boxcraft-picker__title">{{ picker_title }}</h3>
  {% if boxcraft_discount_text != "" %}
    <p class="boxcraft-picker__discount">{{ boxcraft_discount_text }}</p>
  {% endif %}
  <p class="boxcraft-picker__counter" data-boxcraft-counter>
    0 / {{ picker_pick_count }} selected
  </p>

  <div class="boxcraft-picker__grid" data-boxcraft-grid>
    {% if picker_collection != blank %}
      {% for product in picker_collection.products %}
        {% for variant in product.variants %}
          <button
            type="button"
            class="boxcraft-picker__item"
            data-boxcraft-item
            data-variant-id="{{ variant.id }}"
            data-variant-price="{{ variant.price | divided_by: 100.0 }}"
            aria-pressed="false"
          >
            {%- assign item_image = variant.image | default: product.featured_image -%}
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 200 }}"
                alt="{{ variant.title }}"
                loading="lazy"
                width="100"
                height="100"
              >
            {% endif %}
            <span class="boxcraft-picker__item-title">
              {{ product.title }}{% if variant.title != "Default Title" %} — {{ variant.title }}{% endif %}
            </span>
            <span class="boxcraft-picker__item-price">{{ variant.price | money }}</span>
          </button>
        {% endfor %}
      {% endfor %}
    {% endif %}
  </div>

  <p class="boxcraft-picker__blocked-message" data-boxcraft-blocked hidden></p>

  <button type="button" class="boxcraft-picker__add-to-cart" data-boxcraft-add-to-cart disabled>
    Add Bundle to Cart
  </button>
</div>

<script type="module" src="{{ 'pick-n-picker.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Pick-N Picker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "box_handle",
      "label": "Box handle",
      "info": "Matches a box configured in the BoxCraft admin. Leave as \"default\" unless you've created named boxes.",
      "default": "default"
    },
    { "type": "text", "id": "title", "label": "Block title (used if no matching box is found)", "default": "Build your box" },
    { "type": "collection", "id": "eligible_collection", "label": "Eligible products collection (used if no matching box is found)" },
    {
      "type": "range",
      "id": "pick_count",
      "label": "Number of items to pick",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "guardrail_worker_url",
      "label": "Guardrail Worker URL (clear to disable location checks)",
      "default": "https://box-craft.adam-bourg.workers.dev"
    }
  ]
}
{% endschema %}
